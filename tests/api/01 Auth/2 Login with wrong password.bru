meta {
  name: Login with wrong password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "wrong-password"
  }
}

tests {
  test("status 401", function () {
    expect(res.status).to.equal(401);
  });

  test("body is {\"message\":\"Invalid credentials\"}", function () {
    expect(res.body).to.eql({"message":"Invalid credentials"});
  });
}
