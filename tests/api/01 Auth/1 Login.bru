meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("returns token and user", function () {
    expect(res.body.token).to.be.a("string").and.not.empty;
    expect(res.body.user.email).to.equal(bru.getEnvVar("email"));
  });

  test("does not return password", function () {
    expect(res.body.user).to.not.have.property("password");
  });
}
