meta {
  name: Create with long title
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}

tests {
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });

  test("body is {\"message\":\"Validation failed\",\"errors\":{\"title\":\"invalid\"}}", function () {
    expect(res.body).to.eql({"message":"Validation failed","errors":{"title":"invalid"}});
  });
}
