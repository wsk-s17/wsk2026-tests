}

tests {
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });

  test("body is {\"message\":\"Validation failed\",\"errors\":{\"title\":\"required\"}}", function () {
    expect(res.body).to.eql({"message":"Validation failed","errors":{"title":"required"}});
  });
}
